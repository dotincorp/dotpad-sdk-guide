# Auto detect text files and perform LF normalization
* text=auto
sys.dic filter=lfs diff=lfs merge=lfs -text

# Emscripten data packages and wasm binaries are indexed by absolute byte
# offset; CRLF normalization silently corrupts them, so force binary.
*.data binary
*.wasm binary

# Braille engine (ttb-engine) files are checksummed in build-manifest.json and
# some ship with CRLF line endings; keep them byte-identical.
Web/*/DemoApp/public/braille/** -text
