#-display-name: Belarusian computer braille

#+language: be
#+type: computer
#+dots: 8
#+direction: both

# Copyright (C) 2021 by Andrey Yakuboy <braille@yakuboy.ru>
#
#  This file is part of liblouis.
#
#  liblouis is free software: you can redistribute it and/or modify it
