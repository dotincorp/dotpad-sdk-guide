nofor word æ 56-345

# To get contractions correct before/after asterisk and slash, those
# chars have to be redifined as punctuation, not math.
punctuation * 35
punctuation / 34

# Universal accent sign should be used most of the times with contracted braille
noback lowercase á 4-1	   	       	        # a with acute
base uppercase Á á
noback lowercase à 4-1				# a with grave
base uppercase À à
noback lowercase č 4-14   	       	        # c with caron
base uppercase Č č
noback lowercase ç 4-14   	       	        # c with cedilla
base uppercase Ç ç
noback lowercase đ 4-145			# d with stroke
base uppercase Đ đ
noback lowercase ð 4-145			# eth
base uppercase Ð ð
noback lowercase ê 4-15                        # e with circumflex
base uppercase Ê ê
noback lowercase è 4-15			# e with grave
base uppercase È è
noback lowercase ï 4-24			# i with diaeresis
base uppercase Ï ï
noback lowercase í 4-24			# i with acute
base uppercase Í í
noback lowercase ŋ 4-1345			# eng
base uppercase Ŋ ŋ
noback lowercase ô 4-135			# o with circumflex
base uppercase Ô ô 4-6-135
noback lowercase ó 4-135			# o with acute
base uppercase Ó ó
noback lowercase ò 4-135			# o with grave
base uppercase Ò ò
noback lowercase ǫ 4-135			# o with ogonek
base uppercase Ǫ ǫ
noback lowercase þ 4-2345			# thorn
base uppercase Þ þ
noback lowercase ŧ 4-2345			# t with stroke
base uppercase Ŧ ŧ
noback lowercase ṥ 4-234			# s with acute and dot above
base uppercase Ṥ ṥ
noback lowercase š 4-234			# s with caron
base uppercase Š š
noback lowercase ú 4-136			# u with acute
base uppercase Ú ú
noback lowercase ž 4-1356			# z with caro
base uppercase Ž ž
noback lowercase ý 4-13456			# y with acute
base uppercase Ý ý

include no-no-g0.utb
capsnocont
