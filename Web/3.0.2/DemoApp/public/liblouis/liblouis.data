#iut##1#Inuktitut Uncontracted#
#
# -----------
#-index-name: Inuktitut
#-display-name: Inuktitut braille
#
#+language:iu
#+type:literary
#+contraction:no
#+grade:1
#+dots:6
# Marked as "direction:forward" by Bue Vester-Andersen
# as tests only run forward.
#+direction:forward
#

