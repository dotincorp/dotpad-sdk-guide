sign \x0003 1478       # END OF TEXT ( - <Kontrolltegn>)
sign \x0004 14578      # END OF TRANSMISSION ( - <Kontrolltegn>)
sign \x0005 1578       # ENQUIRY ( - <Kontrolltegn>)
sign \x0006 12478      # ACKNOWLEDGE ( - <Kontrolltegn>)
