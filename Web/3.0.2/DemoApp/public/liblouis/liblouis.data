#-index-name: Bashkir
#-display-name: Bashkir braille

#+language: ba
#+type: literary
#+direction: forward

#-license: LGPLv2.1

#  Copyright (C) 2020 Rustam Churagulov <tcdl@yandex.ru>
#
#  This file is part of liblouis.
#
#  liblouis is free software: you can redistribute it and/or modify it
