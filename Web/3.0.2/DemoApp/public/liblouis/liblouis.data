attribute FRACTION \x00BC\x00BD\x00BE\x2150\x2151\x2152\x2153\x2154\x2155\x2156\x2157\x2158\x2159\x215A\x215B\x215C\x215D\x215E
noback context _1$d[%FRACTION] @456-1456*@456-3456
noback context [%FRACTION] @1456*@3456

# The mathematical mark over the other character
attribute MATHABV \x0307\x034C\x20D0\x20D1\x20D6\x20D7\x20DB\x20DC\x20E1 
noback context []$s%MATHABV ?
noback context []!%MATHABV%MATHABV @5

#end Math rules

