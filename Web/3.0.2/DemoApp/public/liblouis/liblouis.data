### Table Metadata

#-name: Dansk forkortet 8-punkt 1993
#-index-name: Danish, contracted, 8-dot, 1993
#-display-name: Danish 8-dot contracted braille (1993 standard)

#+language: da
#+type: literary
#+contraction: full
#+grade: 2
#+dots: 8
#+direction: both
#+system: ddp
#+version: 1993

#-has-nocross: yes

# Display upcodes
include da-dk-octobraille_1993.dis

