#include text_nabcc.dis All display opcodes

include en-ueb-g1.ctb

lowercase ā	456-1
lowercase ē	456-15
lowercase ī	456-24
lowercase ō	456-135
lowercase ū	456-136

base uppercase	Ā ā
base uppercase	Ē ē
base uppercase	Ī ī
base uppercase	Ō ō
base uppercase	Ū ū
