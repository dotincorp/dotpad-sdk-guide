#-index-name: Portuguese, computer, 8-dot
#-display-name: Portuguese 8-dot computer braille
#-name: Tabela Braille para Informática de 8 pontos da língua portuguesa
#-authority: Comissão Brasileira do Braille e Comissão de Braille de Portugal
#
#+language:pt
#+type:computer
#+dots:8
#+direction:both
#+unicode-range: ucs2
#+version: 2004
#
#-maintainer: Tiago Melo Casal <tcasal@intervox.nce.ufrj.br>
#-author: Rui Fontes <rui.fontes@tiflotecnia.com>
#-author: Mesar Hameed <mesar.hameed@gmail.com>
#-author: Victor Montalvao <vsmontalvao@gmail.com>
#-author: Christian Egli <christian.egli@sbs.ch>
#-author: Bert Frees <bertfrees@gmail.com>
#-author: Dave Mielke <dave@mielke.cc>
#-author: Bue Vester-Andersen <bue@vester-andersen.dk>
#-author: Tiago Melo Casal <tcasal@intervox.nce.ufrj.br>
#-updated: 2025-07-31
#
# Two computer braille systems are in use in Portugal and Brazil: the
# 6-dot variant and the 8-dot variant. This table implements the 8-dot
# variant. The 6-dot system is implemented in pt-comp6.utb. 8-dot
# computer braille may be derived from 6-dot computer braille through
# a conversion system.
#
# This table is mainly based on the official Portuguese 8-dot computer
# braille code; defines accented letters, punctuation marks, currency
# signs, Greek letters, some math symbols and other characters/rules.
#
# For the omissions in the official documentation, they were solved
# using approximate character definitions of this table itself and
# resources from other tables so that such gaps would not be left
# uncovered.
#
# Official Braille Code reference:
# Braille Writing for Computing [in Portuguese], 2004, by both
# Brazilian Braille Commission and Braille Commission of Portugal.
# Cataloging-in-Publication data: Grafia Braille para Informática /
# Coordenação: Lêda Lucia Spelta, Maria Glória Batista da Mota ;
# Autores: Antônio Carlos Hildebrandt ... [et al.]. -
# Brasília : MEC, SEESP, 2004. 52 p.
# Available at:
# <https://www.gov.br/mec/pt-br/media/publicacoes/semesp/grafiainfo.pdf>

# spaces
sign \x000a 78	# ⣀	LINE FEED (LF)
include spaces.uti

# Some include
include latinLetterDef8Dots.uti
include digits8Dots.uti

# Punctuation
punctuation ! 2358	# ⢖	ponto de exclamação | EXCLAMATION MARK
punctuation " 236	# ⠦	aspas genérica | QUOTATION MARK
punctuation ' 6	# ⠠	apóstrofo genérico | APOSTROPHE
punctuation ( 1268	# ⢣	abre parênteses | LEFT PARENTHESIS
punctuation ) 3458	# ⢜	fecha parênteses | RIGHT PARENTHESIS
punctuation , 2	# ⠂	vírgula | COMMA
punctuation - 36	# ⠤	tracinho, hífen e/ou menos | HYPHEN-MINUS
punctuation . 3	# ⠄	ponto | FULL STOP
punctuation : 25	# ⠒	dois pontos | COLON
punctuation ; 23	# ⠆	ponto e vírgula | SEMICOLON
punctuation ? 26	# ⠢	ponto de interrogação | QUESTION MARK
punctuation [ 123568	# ⢷	abre colchete ou parênteses reto | LEFT SQUARE BRACKET
punctuation ] 234568	# ⢾	fecha colchete ou parênteses reto | RIGHT SQUARE BRACKET
punctuation { 1238	# ⢇	abre chave ou chaveta | LEFT CURLY BRACKET
punctuation } 4567	# ⡸	fecha chave ou chaveta | RIGHT CURLY BRACKET
punctuation \x2019	6	# ’ ⠠	apóstrofo | RIGHT SINGLE QUOTATION MARK
punctuation \x201C	236	# “ ⠦	abre aspas | LEFT DOUBLE QUOTATION MARK
punctuation \x201D	236	# ” ⠦	fecha aspas | RIGHT DOUBLE QUOTATION MARK

# Fullwidth punctuation
noback punctuation \xFF01	2358	# ！ ⢖	FULLWIDTH EXCLAMATION MARK
noback punctuation \xFF0C	2	# ， ⠂	FULLWIDTH COMMA
noback punctuation \xFF0E	3	# ． ⠄	FULLWIDTH FULL STOP
noback punctuation \xFF1A	25	# ： ⠒	FULLWIDTH COLON
noback punctuation \xFF1B	23	# ； ⠆	FULLWIDTH SEMICOLON
noback punctuation \xFF1F	26	# ？ ⠢	FULLWIDTH QUESTION MARK

# Symbols and special characters
sign # 3456	# ⠼	símbolo de número ou cardinal | NUMBER SIGN
sign & 123468	# ⢯	e comercial | AMPERSAND
sign * 35	# ⠔	asterisco | ASTERISK
sign \x002F	256	# / ⠲	barra | SOLIDUS
sign @ 156	# ⠱	arroba | COMMERCIAL AT
sign \\ 38	# ⢄	barra invertida | REVERSE SOLIDUS
sign _ 367	# ⡤	sublinhado autônomo | LOW LINE
sign | 456	# ⠸	barra vertical | VERTICAL LINE
sign \x00a7 2348	# § ⢎	parágrafo jurídico ou secção | SECTION SIGN
sign \x00aa 178	# ª ⣁	indicador ordinal feminino | FEMININE ORDINAL INDICATOR
sign \x00AB	2368	# « ⢦	abre aspas angulares | LEFT-POINTING DOUBLE ANGLE QUOTATION MARK
sign \x00AC	378	# ¬ ⣄	negação | NOT SIGN
sign \x00B0	356	# ° ⠴	grau | DEGREE SIGN
sign \x00ba 13578	# º ⣕	indicador ordinal masculino | MASCULINE ORDINAL INDICATOR
sign \x00BB	3568	# » ⢴	fecha aspas angulares | RIGHT-POINTING DOUBLE ANGLE QUOTATION MARK
sign \x2227	17	# ∧ ⡁	conjunção | LOGICAL AND
sign \x2228	27	# ∨ ⡂	disjunção | LOGICAL OR

# Mathematical symbols
math % 35678	# ⣴	porcento | PERCENT SIGN
math + 235	# ⠖	mais | PLUS SIGN
math / 256	# ⠲	barra | SOLIDUS
math < 2468	# ⢪	menor que | LESS-THAN SIGN
math = 2356	# ⠶	igual | EQUALS SIGN
math > 1358	# ⢕	maior que | GREATER-THAN SIGN
math \x2212	36	# − ⠤	menos | MINUS SIGN
math \x2229	15678	# ∩ ⣱	interseção | INTERSECTION
math \x222A	34578	# ∪ ⣜	união | UNION
math \x2260	23567	# ≠ ⡶	diferente | NOT EQUAL TO

# Accents and diacritics
sign ^ 234678	# ⣮	acento circunflexo autônomo | CIRCUMFLEX ACCENT
sign ` 14678	# ⣩	acento grave autônomo | GRAVE ACCENT
sign ~ 2346	# ⠮	til autônomo | TILDE
sign \x00A8	23467	# ¨ ⡮	trema | DIAERESIS
sign \x00B4	23468	# ´ ⢮	acento agudo | ACUTE ACCENT

# Currency symbols
sign $ 46	# ⠨	cifrão | DOLLAR SIGN
sign \x00A2	1478	# ¢ ⣉	centavos de dólar | CENT SIGN
sign \x00a3 12378	# £ ⣇	libra | POUND SIGN
sign \x20ac 1578	# € ⣑	EURO SIGN

# Accented letters
uppercase \x00c0 12467	# À ⡫	a grave maiúsculo | LATIN CAPITAL LETTER A WITH GRAVE
uppercase \x00c1 123567	# Á ⡷	a agudo maiúsculo | LATIN CAPITAL LETTER A WITH ACUTE
uppercase \x00c2 167	# Â ⡡	a circunflexo maiúsculo | LATIN CAPITAL LETTER A WITH CIRCUMFLEX
uppercase \x00c3 3457	# Ã ⡜	a til maiúsculo | LATIN CAPITAL LETTER A WITH TILDE
uppercase \x00c7 123467	# Ç ⡯	c cedilha maiúsculo | LATIN CAPITAL LETTER C WITH CEDILLA
uppercase \x00c9 1234567	# É ⡿	e agudo maiúsculo | LATIN CAPITAL LETTER E WITH ACUTE
uppercase \x00ca 1267	# Ê ⡣	e circunflexo maiúsculo | LATIN CAPITAL LETTER E WITH CIRCUMFLEX
uppercase \x00cd 347	# Í ⡌	i agudo maiúsculo | LATIN CAPITAL LETTER I WITH ACUTE
uppercase \x00d3 3467	# Ó ⡬	o agudo maiúsculo | LATIN CAPITAL LETTER O WITH ACUTE
uppercase \x00d4 14567	# Ô ⡹	o circunflexo maiúsculo | LATIN CAPITAL LETTER O WITH CIRCUMFLEX
uppercase \x00d5 2467	# Õ ⡪	o com til maiúsculo | LATIN CAPITAL LETTER O WITH TILDE
uppercase \x00da 234567	# Ú ⡾	u agudo maiúsculo | LATIN CAPITAL LETTER U WITH ACUTE
uppercase \x00dc 12567	# Ü ⡳	u com trema maiúsculo | LATIN CAPITAL LETTER U WITH DIAERESIS
lowercase \x00e0 1246	# à ⠫	a grave minúsculo | LATIN SMALL LETTER A WITH GRAVE
lowercase \x00e1 12356	# á ⠷	a agudo minúsculo | LATIN SMALL LETTER A WITH ACUTE
lowercase \x00e2 16	# â ⠡	a circunflexo minúsculo | LATIN SMALL LETTER A WITH CIRCUMFLEX
lowercase \x00e3 345	# ã ⠜	a til minúsculo | LATIN SMALL LETTER A WITH TILDE
lowercase \x00e7 12346	# ç ⠯	c cedilha minúsculo | LATIN SMALL LETTER C WITH CEDILLA
lowercase \x00e9 123456	# é ⠿	e agudo minúsculo | LATIN SMALL LETTER E WITH ACUTE
lowercase \x00ea 126	# ê ⠣	e circunflexo minúsculo | LATIN SMALL LETTER E WITH CIRCUMFLEX
lowercase \x00ed 34	# í ⠌	i agudo minúsculo | LATIN SMALL LETTER I WITH ACUTE
lowercase \x00f3 346	# ó ⠬	o agudo minúsculo | LATIN SMALL LETTER O WITH ACUTE
lowercase \x00f4 1456	# ô ⠹	o circunflexo minúsculo | LATIN SMALL LETTER O WITH CIRCUMFLEX
lowercase \x00f5 246	# õ ⠪	o com til minúsculo | LATIN SMALL LETTER O WITH TILDE
lowercase \x00fa 23456	# ú ⠾	u agudo minúsculo | LATIN SMALL LETTER U WITH ACUTE
lowercase \x00fc 1256	# ü ⠳	u com trema minúsculo | LATIN SMALL LETTER U WITH DIAERESIS

# Hyphen and other equivalent characters
punctuation \x2010	36	# ‐ ⠤	hífen | HYPHEN
punctuation \x2013	36	# – ⠤	traço de ligação | EN DASH
noback punctuation \x2014	36	# — ⠤	travessão | EM DASH
noback punctuation \x2018	6	# ‘ ⠠	apóstrofo invertido | LEFT SINGLE QUOTATION MARK

# Greek alphabet
uppercase \x0391	17	# Α ⡁	alfa maiúsculo | GREEK CAPITAL LETTER ALPHA
uppercase \x0392	127	# Β ⡃	beta maiúsculo | GREEK CAPITAL LETTER BETA
uppercase \x0393	12457	# Γ ⡛	gama maiúsculo | GREEK CAPITAL LETTER GAMMA
