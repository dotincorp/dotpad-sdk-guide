letter  \xF818  45a            # > #
letter  \xF81C  345a           # @ #
letter  \xF821  16a            # 1 #
letter  \xF822  26a            # ? #
letter  \xF823  126a           # 2 #
letter  \xF824  36b            # - #
letter  \xF826  236a           # ( #
letter  \xF828  46a            # $ #
letter  \xF829  146a           # 3 #
letter  \xF82A  246a           # 9 #
letter  \xF82B  1246a          # 6 #
letter  \xF82C  346a           # 0 #
letter  \xF82E  2346a          # ^ #
letter  \xF82F  12346a         # & #
letter  \xF830  56a            # < #
letter  \xF831  156a           # 5 #
letter  \xF832  256a           # / #
letter  \xF833  1256a          # 8 #
letter  \xF834  356a           # ) #
letter  \xF836  2356a          # = #
letter  \xF837  12356a         # [ #
letter  \xF838  456a           # _ #
letter  \xF839  1456a          # 4 #
letter  \xF83B  12456a         # 7 #
letter  \xF83C  3456a          # # #
letter  \xF83E  23456a         # ] #
letter  \xF83F  123456a        # % #

