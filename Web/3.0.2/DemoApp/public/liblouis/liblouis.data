display \x00c3 578      # 195 Ã    LATIN CAPITAL LETTER A WITH TILDE
display \x00d1 4678     # 209 Ñ    LATIN CAPITAL LETTER N WITH TILDE
display \x00d5 5678     # 213 Õ    LATIN CAPITAL LETTER O WITH TILDE
