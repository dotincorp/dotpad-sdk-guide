always  \s\x2013\s 36-36 # 8211  en dash
always \s\x2014\s 36-36 # em dash
# nobreak 6-46-56-e,6-46-56

# Problems handled with context
# noback context $U2-20[]"'"$l @6-3
noback context _$l["."]$l @256 U.S.
noback context _$d["a"] @56-1
noback context _$d["A"] @56-1

# problems handled with multipass opcodes

# remove dummy caps
noback pass2 @6f-3 ?
noback pass2 @6f ?

noback pass2 @36-36-36 @36-36
noback pass2 @6-236-3456 @3-3456
#corrects Capital A's after a number ending up with letter sign AFTER Caps sign
# noback pass2 @6-56 @56-6 conflicts with "iety"
# Remove space between word and italic signs
#noback pass2 [@0-46-3]   @46@3
#noback pass2 [@46@0]   @46

# Connect one-celled word sign with large sign
noback pass2 @19-0-29 ?

# Come/enough/in may join wordsigns and compound word signs.
noback pass2 @1239-0%wordsignOpen ?
noback pass2 @1239-0-349 ?
noback pass2 [@1239-0%prefix]$lpdsm1-2@349 ?

# to/into/by may be joined only by lower word signs.
noback pass2 %lowerClose@49 ?
noback pass2 %lowerClose@0-49 ?
noback pass2 %wordsignClose@49 @0

# be/con/dis may only be joined by "the" or a lower sign
noback pass2 @2346-129-1349 @2346
noback pass2 %lowerClose@1349 ?
noback pass2 %lowerClose@0-1349 ?
noback pass2 %marker@1349 @0

# Handle sequences starting with lower1 (am/be/is...)
noback pass2 @0-39-2[@139-9]@24 ?
noback pass2 `@39-2[@139-9]@24 ?
noback pass2 @0-39-25[@139]%wordsignOpen ?
noback pass2 `@39-25[@139]%wordsignOpen ?
noback pass2 @0-39-25[@139]@349 ?
noback pass2 `@39-25[@139]@349 ?
noback pass2 @0-39-256[@139]%wordsignOpen ?
noback pass2 `@39-256[@139]%wordsignOpen ?
noback pass2 @0-39-256[@139]@349 ?
noback pass2 `@39-256[@139]@349 ?
noback pass2 @0-39$d[@139]$lpmS @0
noback pass2 `@39$d[@139]$lpmS @0

# "was a" may not start a sequence.
noback pass2 @0-39-356[@139-9]@1-19 @0
noback pass2 `@39-356[@139-9]@1-19 @0

# "was", "were" and "by" may not end a sequence
noback pass2 $lpmdS[@39]@356-139-0 @0
noback pass2 $lpmdS[@39]@356-139~ @0
noback pass2 $lpmdS[@39]@2356-139-0 @0
noback pass2 $lpmdS[@39]@2356-139~ @0

# Keep space before and after "O" etc.
noback pass2 %marker@12349 @0
noback pass2 @12349%marker @0

# No sequencing before letsign
noback pass2 %marker[@56f] @0-56
noback pass2 @56f @56

# Remove left-over markers
noback pass3 [%marker] ?

include en-g3-patterns.dic
# liblouis: U.K. English 8 dot Computer braille table
#
# -----------
#-index-name: English, U.K., computer
#-display-name: English computer braille as used in the U.K.
#
#+language: en
#+region: en-GB
#+type: computer
#+dots: 8
#+system: bauk
#+direction: both
#
# This table implements the specification for 8-dot Braille Computer Notation
# from the Braille Authority of the United Kingdom,
# now inherited by the successor organization
# UK Association for Accessible Formats.
# The specification for this notation can be found here:
# https://www.ukaaf.org/wp-content/uploads/2020/03/Braille-Computer-Notation-PDF.pdf
#
# Compared to the previous implementation (pre 2026), this table
# strictly adheres to the standard in the linked document without
# modification for common characters except for whitespace and
# following the outdated CP-437 encoding as used by the specification
# Notably, many non-printable control characters and rarely used
# symbols have representations under this standard
#
#  Copyright 2026 Seeing Hands <ukcompbraille@seeinghands.org>
#
#  This file is part of liblouis.
#
#  liblouis is free software: you can redistribute it and/or modify it
#  under the terms of the GNU Lesser General Public License as
#  published by the Free Software Foundation, either version 2.1 of the
#  License, or (at your option) any later version.
#
#  liblouis is distributed in the hope that it will be useful, but
#  WITHOUT ANY WARRANTY; without even the implied warranty of
#  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU
#  Lesser General Public License for more details.
#
#  You should have received a copy of the GNU Lesser General Public
#  License along with liblouis. If not, see
#  <http://www.gnu.org/licenses/>.

include latinLetterDef8Dots.uti

# Six-dot base patterns cover ASCII ranges 32-63, 96-127 inclusive

space \s 0
punctuation ! 3456
punctuation " 4
sign # 56
sign $ 456
sign % 46
punctuation & 12346
punctuation ' 3
punctuation ( 45
punctuation ) 345
sign * 35
sign + 235
punctuation , 2
punctuation - 36
punctuation . 256
punctuation / 34
# Digits are almost the same as digits6DotsPlusDot6.uti but 0 is different
# Including this file interferes with dots 346 which should translate to \x007f
digit 0 123456
digit        1      16
digit        2      126
digit        3      146
digit        4      1456
digit        5      156
digit        6      1246
digit        7      12456
digit        8      1256
digit        9      246

punctuation : 25
punctuation ; 23
punctuation < 236
punctuation = 2356
punctuation > 356
punctuation ? 26

sign ` 2346
# Symbols 97-122 imported as part of latinLetterDef8Dots.uti

punctuation { 12356
punctuation | 5
punctuation } 23456
sign ~ 6
sign \x007f 346

# extended 8-dot patterns
# The characters in the specification use the
# CP-437 single-byte character encoding (IBM/DOS)
# The corresponding UTF-8 characters are used here.

# Symbols 0 to 32 are print control characters
sign \x0000 7
sign \x0001 34567
sign \x0002 47
sign \x0003 567
sign \x0004 4567
sign \x0005 467
sign \x0006 123467
sign \x0007 37
sign \x0008 457
# Editor's note: Decided that probably nobody wants to see tab as 3457,
# \r (carridge return) as 357, and
# \n (new line) as 367
# replacing by space in forward translation
# These can be typed in backward translation
nofor sign \x0009 3457
noback space \t 0
nofor sign \x000a 357
noback space \r 0
sign \x000b 2357
sign \x000c 27
nofor sign \x000d 367
noback space \n 0
sign \x000e 2567
sign \x000f 347
sign \x0010 1234567
sign \x0011 167
sign \x0012 1267
sign \x0013 1467
sign \x0014 14567
sign \x0015 1567
sign \x0016 12467
sign \x0017 124567
sign \x0018 12567
sign \x0019 2467
sign \x001a 257
sign \x001b 237
sign \x001c 2367
sign \x001d 23567
sign \x001e 3567
sign \x001f 267

sign @ 23467

# Symbols 65-90 imported as part of latinLetterDef8Dots.uti

sign [ 123567
sign \\ 57
sign ] 234567
sign ^ 67
sign _ 3467


