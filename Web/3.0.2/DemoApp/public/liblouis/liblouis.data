begcapsword 45
endcapsword 6
capsnocont # See section 2.6.2

numsign 3456
numericmodechars .,:
nonumsign 6

# --- Emphasis opcodes ---------------------------------------------------------

emphclass italic
emphclass underline
emphclass bold

