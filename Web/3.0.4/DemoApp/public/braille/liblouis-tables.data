seqafterpattern 'LL
seqafterpattern 'RE
seqafterpattern 'S
seqafterpattern 'T
seqafterpattern 'VE
seqafterexpression '([DSTdst]|ll|[rv]e|LL|[RV]E)
seqafterpattern ’D
seqafterpattern ’LL
seqafterpattern ’RE
seqafterpattern ’S
seqafterpattern ’T
seqafterpattern ’VE
seqafterexpression ’([DSTdst]|ll|[rv]e|LL|[RV]E)

#   7  Punctuation
#  - 7.1.3  could be read as contraction
match %[^_]|%[^_~]%<*[([{] ; %[^_]|[)}\]]%>*%[^_~] 56-23
#     or a word-initial groupsign
match %[^_~]%<* . %a 56-256
match %[^_~]%<* : %a 56-25
match %[^_~]%<* ; %a 56-23

