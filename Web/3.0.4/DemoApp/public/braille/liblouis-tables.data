noback uppercase \x1E9E	23467	# ẞ ⡮	eszett maiúsculo | LATIN CAPITAL LETTER SHARP S

# Bullets and other markers using dots of the asterisk
noback sign \x2022	35	# • ⠔	bolinha | BULLET
noback sign \x25A0	35	# ■ ⠔	quadrado preto | BLACK SQUARE
noback sign \x25A1	35	# □ ⠔	quadrado branco | WHITE SQUARE
noback sign \x25AA	35	# ▪ ⠔	quadradinho preto | BLACK SMALL SQUARE
noback sign \x25CB	35	# ○ ⠔	círculo branco | WHITE CIRCLE
noback sign \x25CF 35	# ● ⠔	círculo | BLACK CIRCLE
noback sign \x25E6	35	# ◦ ⠔	bolinha branca | WHITE BULLET
noback sign \x25FE	35	# ◾ ⠔	quadradinho médio preto | BLACK MEDIUM SMALL SQUARE

# Accented letters of Esperanto using definitions of the book World Braille Usage 3rd edition
noback uppercase \x0108	1467	# Ĉ ⡩	c circunflexo maiúsculo | LATIN CAPITAL LETTER C WITH CIRCUMFLEX
noback lowercase \x0109	146	# ĉ ⠩	c circunflexo minúsculo | LATIN SMALL LETTER C WITH CIRCUMFLEX
noback uppercase \x011C	124567	# Ĝ ⡻	g circunflexo maiúsculo | LATIN CAPITAL LETTER G WITH CIRCUMFLEX
noback lowercase \x011D	12456	# ĝ ⠻	g circunflexo minúsculo | LATIN SMALL LETTER G WITH CIRCUMFLEX
noback uppercase \x0124	12567	# Ĥ ⡳	h circunflexo maiúsculo | LATIN CAPITAL LETTER H WITH CIRCUMFLEX
noback lowercase \x0125	1256	# ĥ ⠳	h circunflexo minúsculo | LATIN SMALL LETTER H WITH CIRCUMFLEX
noback uppercase \x0134	24567	# Ĵ ⡺	j circunflexo maiúsculo | LATIN CAPITAL LETTER J WITH CIRCUMFLEX
noback lowercase \x0135	2456	# ĵ ⠺	j circunflexo minúsculo | LATIN SMALL LETTER J WITH CIRCUMFLEX
noback uppercase \x015C	23467	# Ŝ ⡮	s circunflexo maiúsculo | LATIN CAPITAL LETTER S WITH CIRCUMFLEX
noback lowercase \x015D	2346	# ŝ ⠮	s circunflexo minúsculo | LATIN SMALL LETTER S WITH CIRCUMFLEX
noback uppercase \x016C	3467	# Ŭ ⡬	u breve maiúsculo | LATIN CAPITAL LETTER U WITH BREVE
noback lowercase \x016D	346	# ŭ ⠬	u breve minúsculo | LATIN SMALL LETTER U WITH BREVE

# Normalization of letters combining with diacritic
noback correct "A\x0300" "À"	# À	LATIN CAPITAL LETTER A + COMBINING GRAVE ACCENT
noback correct "a\x0300" "à"	# à	LATIN SMALL LETTER A + COMBINING GRAVE ACCENT
noback correct "A\x0301" "Á"	# Á	LATIN CAPITAL LETTER A + COMBINING ACUTE ACCENT
noback correct "a\x0301" "á"	# á	LATIN SMALL LETTER A + COMBINING ACUTE ACCENT
noback correct "A\x0302" "Â"	# Â	LATIN CAPITAL LETTER A + COMBINING CIRCUMFLEX ACCENT
noback correct "a\x0302" "â"	# â	LATIN SMALL LETTER A + COMBINING CIRCUMFLEX ACCENT
noback correct "A\x0303" "Ã"	# Ã	LATIN CAPITAL LETTER A + COMBINING TILDE
noback correct "a\x0303" "ã"	# ã	LATIN SMALL LETTER A + COMBINING TILDE
noback correct "A\x0308" "Ä"	# Ä	LATIN CAPITAL LETTER A + COMBINING DIAERESIS
noback correct "a\x0308" "ä"	# ä	LATIN SMALL LETTER A + COMBINING DIAERESIS
noback correct "A\x030A" "Å"	# Å	LATIN CAPITAL LETTER A + COMBINING RING ABOVE
noback correct "a\x030A" "å"	# å	LATIN SMALL LETTER A + COMBINING RING ABOVE
noback correct "C\x0302" "Ĉ"	# Ĉ	LATIN CAPITAL LETTER C + COMBINING CIRCUMFLEX ACCENT
noback correct "c\x0302" "ĉ"	# ĉ	LATIN SMALL LETTER C + COMBINING CIRCUMFLEX ACCENT
noback correct "C\x0327" "Ç"	# Ç	LATIN CAPITAL LETTER C + COMBINING CEDILLA
noback correct "c\x0327" "ç"	# ç	LATIN SMALL LETTER C + COMBINING CEDILLA
noback correct "E\x0300" "È"	# È	LATIN CAPITAL LETTER E + COMBINING GRAVE ACCENT
noback correct "e\x0300" "è"	# è	LATIN SMALL LETTER E + COMBINING GRAVE ACCENT
noback correct "E\x0301" "É"	# É	LATIN CAPITAL LETTER E + COMBINING ACUTE ACCENT
noback correct "e\x0301" "é"	# é	LATIN SMALL LETTER E + COMBINING ACUTE ACCENT
noback correct "E\x0302" "Ê"	# Ê	LATIN CAPITAL LETTER E + COMBINING CIRCUMFLEX ACCENT
noback correct "e\x0302" "ê"	# ê	LATIN SMALL LETTER E + COMBINING CIRCUMFLEX ACCENT
noback correct "E\x0308" "Ë"	# Ë	LATIN CAPITAL LETTER E + COMBINING DIAERESIS
noback correct "e\x0308" "ë"	# ë	LATIN SMALL LETTER E + COMBINING DIAERESIS
noback correct "G\x0302" "Ĝ"	# Ĝ	LATIN CAPITAL LETTER G + COMBINING CIRCUMFLEX ACCENT
noback correct "g\x0302" "ĝ"	# ĝ	LATIN SMALL LETTER G + COMBINING CIRCUMFLEX ACCENT
noback correct "H\x0302" "Ĥ"	# Ĥ	LATIN CAPITAL LETTER H + COMBINING CIRCUMFLEX ACCENT
noback correct "h\x0302" "ĥ"	# ĥ	LATIN SMALL LETTER H + COMBINING CIRCUMFLEX ACCENT
noback correct "I\x0300" "Ì"	# Ì	LATIN CAPITAL LETTER I + COMBINING GRAVE ACCENT
noback correct "i\x0300" "ì"	# ì	LATIN SMALL LETTER I + COMBINING GRAVE ACCENT
