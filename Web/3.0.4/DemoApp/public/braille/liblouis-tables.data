noback sign \x0280 35-1235     # ʀ - small capital r - voiced uvular trill
noback sign \x027E 235-1235    # ɾ - fish-hook r - voiced alveolar tap
noback sign \x027D 256-1235    # ɽ - right-tail r - voiced retroflex flap
