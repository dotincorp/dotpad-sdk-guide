letter	\x0D7A	235-3456		# MALAYALAM LETTER CHILLU NN
# letter	\x0D23\x0D4D\x200D	235-3456	# second way of writing MALAYALAM LETTER CHILLU NN

letter	\x0D7B	235-1345		# MALAYALAM LETTER CHILLU N
# letter	\x0D28\x0D4D\x200D	235-1345 # second method of writing MALAYALAM LETTER CHILLU N

letter     \x0D7C   235-12456 	# MALAYALAM LETTER CHILLU RR (historically derived from the full    letter ra) and (also used for chillu r)
# letter	\x0D30\x0D4D\x200D	235-12456	# second way of writing MALAYALAM LETTER CHILLU RR (historically derived from the full    letter ra) and (also used for chillu r)

letter     \x0D7D    235-123	# MALAYALAM LETTER CHILLU L (historically derived from the full letter ta) and  (used for chillu t and chillu d)
# letter	\x0D32\x0D4D\x200D	235-123	# second way of writing MALAYALAM LETTER CHILLU L 

letter	\x0D7E	235-456	# MALAYALAM LETTER CHILLU LL
# letter	\x0D33\x0D4D\x200D	235-456	# second way of writing MALAYALAM LETTER CHILLU LL


# Obsolete in make backward translation and prevent doubling the letter
noback letter	\x0D7F	235-13-13	# MALAYALAM LETTER CHILLU K

