nofor correct ".Q"["u"]"." ?
nofor correct "qu"["u"] ?
nofor correct "QU"["U"] ?
#gestion du tiret en début de mot
noback correct `"-"$l "`"*
noback correct $s["-"]$l "`-"

#Parenthèse dans un mot
noback correct $l["("] "\x201E("
nofor correct $l["„"]"(" ?

#Minuscule suivie d'une majuscule
