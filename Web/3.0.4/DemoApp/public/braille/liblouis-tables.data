endword \x0027 356-3 # APOSTROPHE

endword \x0D4D\x0027 3-356-3 # MALAYALAM SIGN VIRAMA + APOSTROPHE 

endword \x0D4D\x003A 3-25 # MALAYALAM SIGN VIRAMA + COLON

endword \x0D4D\x003B 3-23 # MALAYALAM SIGN VIRAMA + SEMICOLON

endword \x002A 35-35 # ASTERISK
endword \x0D40\x002A 35-35-35 # MALAYALAM VOWEL SIGN II + ASTERISK

